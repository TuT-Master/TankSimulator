  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Hull:

    Q -> engage reverse or neutral if forward engaged

    E ->
    engage forward or neutral if reverse engaged

    Click W/S -> when gear engaged
    increase throttle

    AD -> turn when forward or reverse engaged


    Cannon+turret:

    K
    -> rest position for turret and cannon

    P -> loader enable fire for gunner

    X
    -> fire main gun

    hold RMB + MOUSE -> aiming with commander periscope

    R
    -> switch betwenn fast and slow mode for commander periscope

    V -> when aiming
    with commander periscope lead gun to that direction


    Player:

    MOUSE
    -> looking

    LMB -> interacting (only for commander periscope atm)

    B
    -> binoculars

    O -> look out of hatch (2 positions)

    I -> go back inside'
  m_isRightToLeft: 0
